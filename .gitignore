# Secrets — never commit
.env
.env.*
!.env.example
infra/langfuse/.env

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Generated artefacts — regenerable by `make all` (invariant I5)
data/seed/*
!data/seed/.gitkeep
data/generated/*
!data/generated/.gitkeep
results/*
!results/.gitkeep
# Phase 3 DoD (BUILD-PLAN §9): the C2 coverage report is committed evidence,
# regenerated byte-identically by `make scenario && make ingest` (no volatile
# field enters the coverage counters).
!results/e2_coverage.json
# Phase 7 DoD (BUILD-PLAN §9): the judge response cache is committed so the
# evaluation replays without API access (invariant I5). Both lines are
# needed: the first un-ignores the directory so git descends into it.
!data/generated/judge_cache/
!data/generated/judge_cache/**

# Claude Code local state (credentials, per-machine overrides)
.claude/settings.local.json
.claude/*.local.json

# Serena
.serena/cache/

# graphify knowledge graph (regenerate with `graphify update .`)
graphify-out/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
